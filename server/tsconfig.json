{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "outDir": "../dist-server",
    "rootDir": ".",
    "noEmit": false,
    "incremental": false
  },
  "include": ["*.ts"],
  "exclude": ["*.test.ts"]
}
