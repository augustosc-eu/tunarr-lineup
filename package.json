{
  "name": "tunarr-lineup",
  "version": "0.1.0",
  "description": "A Mac OS 9-styled, TV-remote-friendly programming desk for Tunarr channels",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/augustosc-eu/tunarr-lineup.git"
  },
  "homepage": "https://github.com/augustosc-eu/tunarr-lineup#readme",
  "bugs": {
    "url": "https://github.com/augustosc-eu/tunarr-lineup/issues"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "dev:local": "vite --config vite.local.config.ts",
    "build:local": "vite build --config vite.local.config.ts && tsc -p server/tsconfig.json",
    "start:local": "node dist-server/main.js",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern dist-local --ignore-pattern dist-server",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@cloudflare/workers-types": "5.20261005.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.35",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.1",
    "vite": "8.3.2",
    "vitest": "^4.1.11",
    "wrangler": "4.147.0"
  },
  "type": "module",
  "overrides": {
    "fflate": "^0.7.5",
    "sharp": "^0.35.5"
  }
}
